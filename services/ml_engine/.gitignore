# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environment & local settings
.env
.env.*
!.env.example

# Ignore generated binary models (keep folder structure via .gitkeep)
models/*
!models/.gitkeep

# Ignore generated evaluation reports & figures
reports/*
!reports/.gitkeep

# Logs & temp files
*.log
logs/
.pytest_cache/
